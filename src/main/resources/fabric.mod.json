{
    "schemaVersion": 1,
    "id": "ecumenopolismc",
    "version": "${version}",
    "name": "Ecumenopolis",
    "description": "Generates large multi-level cities",
    "authors": [
        "Mark Lagodych <lgd.mrk@outlook.com>"
    ],
    "contact": {
        "homepage": "https://github.com/MarkLagodych/EcumenopolisMC",
        "sources": "https://github.com/MarkLagodych/EcumenopolisMC"
    },
    "license": "LGPL-3.0-only",
    "icon": "assets/ecumenopolismc/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "org.ecumenopolismc.EcumenopolisMod"
        ],
        "client": [
            "org.ecumenopolismc.client.EcumenopolisClient"
        ]
    },
    "mixins": [
        "ecumenopolismc.mixins.json",
        {
            "config": "ecumenopolismc.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.3",
        "minecraft": "~26.2",
        "java": ">=25",
        "fabric-api": "*"
    }
}
